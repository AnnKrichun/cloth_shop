<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- =================================================================== -->
        <!-- 1. DEMO BRANDS CONFIGURATIONS                                       -->
        <!-- =================================================================== -->
        <record id="demo_brand_urban" model="cloth.brand">
            <field name="name">Urban Style</field>
            <field name="country_id" ref="base.ua"/>
            <field name="logo" type="base64" file="cloth_shop/demo/static/brand_urban.png"/>
        </record>
        <record id="demo_brand_apex" model="cloth.brand">
            <field name="name">Apex Athlete</field>
            <field name="country_id" ref="base.us"/>
            <field name="logo" type="base64" file="cloth_shop/demo/static/brand_apex.png"/>
        </record>
        <record id="demo_brand_green" model="cloth.brand">
            <field name="name">Milano Elegance</field>
            <field name="country_id" ref="base.it"/>
            <field name="logo" type="base64" file="cloth_shop/demo/static/brand_milano.png"/>
        </record>

        <!-- =================================================================== -->
        <!-- 2. DEMO SIZES INFRASTRUCTURE MATRIX                                 -->
        <!-- =================================================================== -->
        <record id="demo_size_s" model="cloth.size">
            <field name="name">S</field>
        </record>
        <record id="demo_size_m" model="cloth.size">
            <field name="name">M</field>
        </record>
        <record id="demo_size_l" model="cloth.size">
            <field name="name">L</field>
        </record>

        <!-- =================================================================== -->
        <!-- 3. DEMO SEASON COLLECTIONS                                          -->
        <!-- =================================================================== -->
        <record id="demo_collection_summer" model="cloth.collection">
            <field name="name">Summer Breeze 2026</field>
        </record>
        <record id="demo_collection_autumn" model="cloth.collection">
            <field name="name">Autumn Gold 2026</field>
        </record>
        <record id="demo_collection_essentials" model="cloth.collection">
            <field name="name">Core Essentials</field>
        </record>

        <!-- =================================================================== -->
        <!-- 4. DEMO MARKUP COEFFICIENTS SYSTEM                                  -->
        <!-- =================================================================== -->
        <record id="demo_markup_standard" model="cloth.markup.coefficient">
            <field name="brand_id" ref="demo_brand_urban"/>
            <field name="collection_id" ref="demo_collection_summer"/>
            <field name="coefficient">1.50</field>
        </record>
        <record id="demo_markup_premium" model="cloth.markup.coefficient">
            <field name="brand_id" ref="demo_brand_apex"/>
            <field name="collection_id" ref="demo_collection_autumn"/>
            <field name="coefficient">2.00</field>
        </record>
        <record id="demo_markup_accessories" model="cloth.markup.coefficient">
            <field name="brand_id" ref="demo_brand_green"/>
            <field name="collection_id" ref="demo_collection_essentials"/>
            <field name="coefficient">1.20</field>
        </record>

        <!-- =================================================================== -->
        <!-- 5. DEMO GENERAL MASTER PRODUCTS (CLEANED FROM SIZES)                -->
        <!-- =================================================================== -->
        <record id="demo_product_tshirt" model="cloth.product">
            <field name="name">Classic Cotton T-Shirt</field>
            <field name="sku">TSH-URB-GEN</field>
            <field name="brand_id" ref="demo_brand_urban"/>
            <field name="collection_id" ref="demo_collection_summer"/>
        </record>
        <record id="demo_product_hoodie" model="cloth.product">
            <field name="name">Sport Performance Hoodie</field>
            <field name="sku">HUD-APX-GEN</field>
            <field name="brand_id" ref="demo_brand_apex"/>
            <field name="collection_id" ref="demo_collection_autumn"/>
        </record>
        <record id="demo_product_jeans" model="cloth.product">
            <field name="name">Slim Fit Denim Jeans</field>
            <field name="sku">JNS-MIL-GEN</field>
            <field name="brand_id" ref="demo_brand_green"/>
            <field name="collection_id" ref="demo_collection_essentials"/>
        </record>

        <!-- =================================================================== -->
        <!-- 6. DEMO GOODS RECEIPTS VOUCHERS                                     -->
        <!-- =================================================================== -->
        <record id="demo_receipt_001" model="cloth.receipt">
            <field name="name">WH/IN/2026/0001</field>
            <field name="date">2026-05-01</field>
            <field name="state">done</field>
        </record>
        <record id="demo_receipt_002" model="cloth.receipt">
            <field name="name">WH/IN/2026/0002</field>
            <field name="date">2026-05-15</field>
            <field name="state">done</field>
        </record>
        <record id="demo_receipt_003" model="cloth.receipt">
            <field name="name">WH/IN/2026/0003</field>
            <field name="date">2026-06-01</field>
            <field name="state">draft</field>
        </record>

        <!-- =================================================================== -->
        <!-- 7. DEMO GOODS RECEIPT LINES (SIZES MOVED HERE)                      -->
        <!-- =================================================================== -->
        <record id="demo_receipt_line_001" model="cloth.receipt.line">
            <field name="receipt_id" ref="demo_receipt_001"/>
            <field name="sku_id" ref="demo_product_tshirt"/>
            <field name="size_id" ref="demo_size_s"/>
            <field name="purchase_currency_id" ref="base.UAH"/>
            <field name="qty">50</field>
            <field name="purchase_price">15.00</field>
            <field name="retail_price">22.50</field>
        </record>
        <record id="demo_receipt_line_002" model="cloth.receipt.line">
            <field name="receipt_id" ref="demo_receipt_002"/>
            <field name="sku_id" ref="demo_product_hoodie"/>
            <field name="size_id" ref="demo_size_m"/>
            <field name="purchase_currency_id" ref="base.UAH"/>
            <field name="qty">30</field>
            <field name="purchase_price">35.00</field>
            <field name="retail_price">70.00</field>
        </record>
        <record id="demo_receipt_line_003" model="cloth.receipt.line">
            <field name="receipt_id" ref="demo_receipt_002"/>
            <field name="sku_id" ref="demo_product_jeans"/>
            <field name="size_id" ref="demo_size_l"/>
            <field name="purchase_currency_id" ref="base.UAH"/>
            <field name="qty">20</field>
            <field name="purchase_price">25.00</field>
            <field name="retail_price">37.50</field>
        </record>
        <record id="demo_receipt_line_004" model="cloth.receipt.line">
            <field name="receipt_id" ref="demo_receipt_003"/>
            <field name="sku_id" ref="demo_product_tshirt"/>
            <field name="size_id" ref="demo_size_s"/>
            <field name="purchase_currency_id" ref="base.UAH"/>
            <field name="qty">10</field>
            <field name="purchase_price">15.00</field>
            <field name="retail_price">0.00</field>
        </record>

        <!-- =================================================================== -->
        <!-- 8. DEMO CUSTOMER SALES ORDERS                                       -->
        <!-- =================================================================== -->
        <record id="demo_order_001" model="cloth.order">
            <field name="date_order">2026-05-20 12:00:00</field>
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="delivery_address">123 Kyivska Str, Apt 4, Kyiv, Ukraine</field>
            <field name="state">shipped</field>
        </record>
        <record id="demo_order_002" model="cloth.order">
            <field name="date_order">2026-05-23 15:30:00</field>
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="delivery_address">45 Lvivska Str, Lviv, Ukraine</field>
            <field name="state">received</field>
        </record>
        <record id="demo_order_003" model="cloth.order">
            <field name="date_order">2026-05-24 10:15:00</field>
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="delivery_address">78 Odeska Str, Odesa, Ukraine</field>
            <field name="state">draft</field>
        </record>

        <!-- =================================================================== -->
        <!-- 9. DEMO SALES ORDER LINES WITH SIZES INCLUDED                       -->
        <!-- =================================================================== -->
        <record id="demo_order_line_001" model="cloth.order.line">
            <field name="order_id" ref="demo_order_001"/>
            <field name="product_id" ref="demo_product_tshirt"/>
            <field name="size_id" ref="demo_size_s"/>
            <field name="qty">2</field>
        </record>
        <record id="demo_order_line_002" model="cloth.order.line">
            <field name="order_id" ref="demo_order_002"/>
            <field name="product_id" ref="demo_product_hoodie"/>
            <field name="size_id" ref="demo_size_m"/>
            <field name="qty">1</field>
        </record>
        <record id="demo_order_line_003" model="cloth.order.line">
        <field name="order_id" ref="demo_order_003"/>
        <field name="product_id" ref="demo_product_jeans"/>
            <field name="size_id" ref="demo_size_m"/>
        <field name="qty">1</field>
    </record>
    </data>
</odoo>
