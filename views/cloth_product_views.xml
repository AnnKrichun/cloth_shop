<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ПОШУК ТОВАРІВ -->
        <record id="view_cloth_product_search" model="ir.ui.view">
            <field name="name">cloth.product.search</field>
            <field name="model">cloth.product</field>
            <field name="arch" type="xml">
                <search string="Product Search">
                    <field name="name" string="SKU Code"/>
                    <field name="product_title" string="Product Name"/>
                    <field name="brand_id"/>
                    <field name="collection_id"/>
                </search>
            </field>
        </record>

        <!-- СПИСОК ТОВАРІВ -->
        <record id="view_cloth_product_list" model="ir.ui.view">
            <field name="name">cloth.product.list</field>
            <field name="model">cloth.product</field>
            <field name="arch" type="xml">
                <list string="Products">
                    <field name="name" string="SKU"/>
                    <field name="product_title" string="Product Name"/>
                    <field name="brand_id"/>
                    <field name="collection_id"/>
                </list>
            </field>
        </record>

        <!-- КАНБАН ТОВАРІВ (🔒 Фікс для Odoo 19 / Owl Engine) -->
        <record id="view_cloth_product_kanban" model="ir.ui.view">
            <field name="name">cloth.product.kanban</field>
            <field name="model">cloth.product</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <!-- Змінено t-name на card для сумісності з сучасним JS-валідатором -->
                        <t t-name="card">
                            <div class="oe_kanban_global_click p-3">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title text-primary fs-5">
                                        <field name="name"/>
                                    </strong>
                                    <div class="mt-2 text-muted">
                                        <span>Name: </span><field name="product_title"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- СТАТИСТИЧНІ ДІЇ ДЛЯ КНОПОК -->
        <record id="action_cloth_brand_stat" model="ir.actions.act_window">
            <field name="name">Brands</field>
            <field name="res_model">cloth.brand</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_cloth_order_stat" model="ir.actions.act_window">
            <field name="name">Orders</field>
            <field name="res_model">cloth.order</field>
            <field name="view_mode">list,form,pivot,graph</field>
        </record>

        <!-- ФОРМА КАРТКИ ТОВАРУ -->
        <record id="view_cloth_product_form" model="ir.ui.view">
            <field name="name">cloth.product.form</field>
            <field name="model">cloth.product</field>
            <field name="arch" type="xml">
                <form string="Product">
                    <sheet>
                        <!-- Стат-кнопки із чистим виведенням для Odoo 19 -->
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_cloth_order_stat)d" type="action" class="oe_stat_button" icon="fa-shopping-cart">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_text">Orders</span>
                                </div>
                            </button>
                            <button name="%(action_cloth_brand_stat)d" type="action" class="oe_stat_button" icon="fa-tag">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_text">Brand</span>
                                </div>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="SKU / Article Code"/>
                            <h1>
                                <field name="name" placeholder="e.g. TY77, 897..." class="oe_inline"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Core Specifications Parameters">
                                <field name="product_title" placeholder="Model Name (e.g. Turbo, Air Max)..."/>
                                <field name="brand_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="collection_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group string="Size Matrix Stock &amp; Active Prices">
                                <field name="stock_line_ids" nolabel="1">
                                    <list create="0" delete="0" edit="0">
                                        <field name="size_id"/>
                                        <field name="qty_available"/>
                                        <!-- Поле ціни тепер автоматично читає дані з нашої нової моделі-матриці -->
                                        <field name="retail_price" string="Current Retail Price"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ГОЛОВНА ДІЯ ТОВАРІВ -->
        <record id="action_cloth_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">cloth.product</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_cloth_product_search"/>
        </record>

    </data>
</odoo>
