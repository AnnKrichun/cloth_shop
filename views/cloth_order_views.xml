<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_cloth_order_list" model="ir.ui.view">
            <field name="name">cloth.order.list</field>
            <field name="model">cloth.order</field>
            <field name="arch" type="xml">
                <list string="Customer Orders">
                    <field name="name"/>
                    <field name="date_order"/>
                    <field name="partner_id"/>
                    <field name="amount_total" sum="Total Sales"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'"
                           decoration-success="state == 'received'" decoration-warning="state == 'shipped'"/>
                </list>
            </field>
        </record>

        <record id="view_cloth_order_form" model="ir.ui.view">
            <field name="name">cloth.order.form</field>
            <field name="model">cloth.order</field>
            <field name="arch" type="xml">
                <form string="Customer Sales Order">

                    <header>
                        <button name="action_recalculate_discount"
                                string="Recalculate Discount"
                                type="object"
                                invisible="state != 'draft'"
                                class="btn-secondary"
                                icon="fa-refresh"/>
                        <button name="action_state_shipped" string="Ship to Customer" type="object"
                                invisible="state != 'draft'" class="btn-primary" icon="fa-truck"/>
                        <button name="action_state_received" string="Mark as Received" type="object"
                                invisible="state != 'shipped'" class="btn-success" icon="fa-check-circle"/>
                        <button name="action_state_cancelled" string="Cancel Order" type="object"
                                invisible="state != 'draft'" class="btn-secondary" icon="fa-times"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,shipped,received"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Customer Details">
                                <field name="partner_id" options="{'no_quick_create': True}"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group string="Logistics">
                                <field name="date_order" readonly="state != 'draft'"/>
                                <field name="delivery_address" placeholder="Country, City, Street, ZIP..."
                                       readonly="state != 'draft'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Order Lines" name="order_lines">
                                <field name="line_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="product_id"
                                               options="{'no_create': True, 'no_quick_create': True}"/>
                                        <field name="size_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="qty"/>
                                        <field name="price_unit" string="Unit Price" readonly="1" force_save="1"/>
                                        <field name="price_subtotal" readonly="1"/>
                                    </list>
                                </field>

                                <group class="oe_subtotal_footer oe_right">
                                    <field name="discount" readonly="state != 'draft'"/>
                                    <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                </group>
                                <div class="oe_clear"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cloth_order_search" model="ir.ui.view">
            <field name="name">cloth.order.search</field>
            <field name="model">cloth.order</field>
            <field name="arch" type="xml">
                <search string="Search Customer Orders">
                </search>
            </field>
        </record>

        <record id="view_cloth_order_search" model="ir.ui.view">
            <field name="name">cloth.order.search</field>
            <field name="model">cloth.order</field>
            <field name="arch" type="xml">
                <search string="Search Customer Orders">
                </search>
            </field>
        </record>

        <record id="view_cloth_order_kanban" model="ir.ui.view">
            <field name="name">cloth.order.kanban</field>
            <field name="model">cloth.order</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" records_draggable="true" quick_create="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="amount_total"/>
                    <field name="date_order"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click d-flex flex-column justify-content-between p-3"
                                 style="min-height: 110px;">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title text-primary fs-5">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body text-muted mb-2">
                                    <div class="fw-bold">
                                        <field name="partner_id"/>
                                    </div>
                                    <small>
                                        <field name="date_order" widget="date"/>
                                    </small>
                                </div>
                                <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center border-top pt-2">
                                    <div class="oe_kanban_bottom_left">
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge rounded-pill bg-success text-white px-2 py-1 fs-6 fw-bold">
                                            <field name="amount_total" widget="monetary"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_cloth_order" model="ir.actions.act_window">
            <field name="name">Customer Orders</field>
            <field name="res_model">cloth.order</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_cloth_order_search"/>
        </record>

    </data>
</odoo>
