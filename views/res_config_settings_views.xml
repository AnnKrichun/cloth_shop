<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            ===================================================================
            CLOTHING SHOP EXCLUSIVE CONFIGURATION FORM VIEW
            ===================================================================
        -->
        <record id="view_cloth_shop_config_settings_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.cloth</field>
            <field name="model">res.config.settings</field>
            <field name="arch" type="xml">
                <form string="Configuration" class="oe_form_configuration">
                    <header>
                        <button string="Save" type="object" name="execute" class="oe_highlight" icon="fa-save"/>
                        <button string="Discard" type="object" name="cancel" class="btn-secondary" icon="fa-close"/>
                    </header>
                    <sheet>
                        <h2>Clothing Shop Settings</h2>
                        <div class="row mt16 o_settings_container" name="cloth_shop_setting_container">

                            <!-- Box Segment: Retail Pricing Currency Options Setting -->
                            <div class="col-12 col-lg-6 o_setting_box" id="retail_currency_setting">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Global Pricing Currency</span>
                                    <div class="text-muted">
                                        Select the main currency standard for store customer retail sales tags execution.
                                    </div>
                                    <div class="content-group mt8">
                                        <field name="retail_currency_id" options="{'no_create': True, 'no_open': True}"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
