<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Main Application Menu Node Link Object Element Token -->
    <menuitem id="menu_cloth_shop_root"
              name="Clothing Shop"
              web_icon="cloth_shop,static/description/icon.png"
              sequence="5"/>

    <!-- Products master directories warehouse control routing nodes -->
    <menuitem id="menu_cloth_product"
              name="Products (Stock)"
              parent="menu_cloth_shop_root"
              action="action_cloth_product"
              sequence="5"/>

    <!-- Documents structural operational registry navigation panels header nodes -->
    <menuitem id="menu_cloth_shop_documents"
              name="Operational Documents"
              parent="menu_cloth_shop_root"
              sequence="10"/>

    <menuitem id="menu_cloth_receipt"
              name="Goods Receipts"
              parent="menu_cloth_shop_documents"
              action="action_cloth_receipt"
              sequence="10"/>

    <menuitem id="menu_cloth_order"
              name="Customer Orders"
              parent="menu_cloth_shop_documents"
              action="action_cloth_order"
              sequence="20"/>

    <menuitem id="menu_cloth_shop_reporting"
              name="Reporting"
              parent="menu_cloth_shop_root"
              sequence="15"/>

    <menuitem id="menu_cloth_inventory_report"
              name="Inventory Turnover &amp; Valuation"
              parent="menu_cloth_shop_reporting"
              action="action_cloth_inventory_report"
              sequence="10"/>

    <menuitem id="menu_cloth_profitability_report"
              name="Profitability Report"
              parent="menu_cloth_shop_reporting"
              action="action_cloth_profitability_report"
              sequence="20"/>

    <!-- ========================================================================= -->
    <!-- CONFIGURATION REGISTRY (ГОЛОВНОЙ ТАБ КОНФИГУРАЦИИ)                       -->
    <!-- ========================================================================= -->
    <menuitem id="menu_cloth_shop_config"
              name="Configuration"
              parent="menu_cloth_shop_root"
              sequence="20"/>

    <!-- 📂 ПОДМЕНЮ 1: ДОВИДНИКИ (Directories) -->
    <menuitem id="menu_cloth_config_directories_group"
              name="Directories"
              parent="menu_cloth_shop_config"
              sequence="10"/>

    <!-- 💰 ПОДМЕНЮ 2: ЦЕНООБРАЗОВАНИЕ (Pricing) -->
    <menuitem id="menu_cloth_config_pricing_group"
              name="Pricing"
              parent="menu_cloth_shop_config"
              sequence="20"/>

    <!-- ========================================================================= -->
    <!-- ПУНКТЫ ДЛЯ РАЗДЕЛА "Directories"                                         -->
    <!-- ========================================================================= -->
    <record id="action_cloth_shop_settings_final_clean_route" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_cloth_shop_config_settings_form"/>
    </record>

    <menuitem id="menu_cloth_config_settings"
              name="Settings"
              parent="menu_cloth_config_directories_group"
              action="action_cloth_shop_settings_final_clean_route"
              sequence="5"/>

    <menuitem id="menu_cloth_brand"
              name="Brands"
              parent="menu_cloth_config_directories_group"
              action="action_cloth_brand"
              sequence="10"/>

    <menuitem id="menu_cloth_size"
              name="Sizes"
              parent="menu_cloth_config_directories_group"
              action="action_cloth_size"
              sequence="20"/>

    <menuitem id="menu_cloth_collection"
              name="Collections"
              parent="menu_cloth_config_directories_group"
              action="action_cloth_collection"
              sequence="30"/>

    <!-- ========================================================================= -->
    <!-- ПУНКТЫ ДЛЯ РАЗДЕЛА "Pricing"                                             -->
    <!-- ========================================================================= -->
    <menuitem id="menu_cloth_markup"
              name="Markup Coefficients"
              parent="menu_cloth_config_pricing_group"
              action="action_cloth_markup"
              sequence="10"/>

    <menuitem id="menu_cloth_shop_currency_rates"
              name="Currency Rates Monitoring"
              parent="menu_cloth_config_pricing_group"
              action="action_cloth_shop_currency_rates"
              sequence="20"/>

    <!-- ========================================================================= -->
    <!-- 🆕 НАШ НОВЫЙ ПУНКТ: МАТРИЦЯ РОЗДРІБНИХ ЦІН (Клієнтський інтерфейс)        -->
    <!-- ========================================================================= -->

    <!-- Описание отображения таблицы для Odoo 19 -->
    <record id="view_cloth_product_price_list" model="ir.ui.view">
        <field name="name">cloth.product.price.list</field>
        <field name="model">cloth.product.price</field>
        <field name="arch" type="xml">
            <list string="Product Retail Prices" editable="bottom">
                <field name="product_id"/>
                <field name="size_id"/>
                <field name="retail_price"/>
            </list>
        </field>
    </record>

    <!-- Экшн для открытия матрицы цен -->
    <record id="action_cloth_product_price_matrix" model="ir.actions.act_window">
        <field name="name">Product Retail Prices Matrix</field>
        <field name="res_model">cloth.product.price</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_cloth_product_price_list"/>
        <field name="target">current</field>
    </record>

    <!-- Пункт меню матрицы цен -->
    <menuitem id="menu_cloth_product_price_matrix"
              name="Product Retail Prices"
              parent="menu_cloth_config_pricing_group"
              action="action_cloth_product_price_matrix"
              sequence="30"/>
</odoo>
