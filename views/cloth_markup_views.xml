<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_cloth_markup_list" model="ir.ui.view">
            <field name="name">cloth.markup.coefficient.list</field>
            <field name="model">cloth.markup.coefficient</field>
            <field name="arch" type="xml">
                <list string="Markup Multipliers" editable="bottom">
                    <field name="brand_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="collection_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="coefficient"/>
                </list>
            </field>
        </record>

        <record id="view_cloth_markup_form" model="ir.ui.view">
            <field name="name">cloth.markup.coefficient.form</field>
            <field name="model">cloth.markup.coefficient</field>
            <field name="arch" type="xml">
                <form string="Markup Multiplier">
                    <sheet>
                        <group>
                            <group>
                                <field name="brand_id" options="{'no_create': True}"/>
                                <field name="collection_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <field name="coefficient"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cloth_markup_search" model="ir.ui.view">
            <field name="name">cloth.markup.coefficient.search</field>
            <field name="model">cloth.markup.coefficient</field>
            <field name="arch" type="xml">
                <search string="Search Markup Ratios">
                    <field name="brand_id"/>
                    <field name="collection_id"/>
                    <separator/>
                    <filter string="Group by Brand" name="group_by_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Group by Collection" name="group_by_collection"
                            context="{'group_by': 'collection_id'}"/>
                </search>
            </field>
        </record>

        <record id="action_cloth_markup" model="ir.actions.act_window">
            <field name="name">Markup Ratios Matrix</field>
            <field name="res_model">cloth.markup.coefficient</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_cloth_markup_search"/>
        </record>

    </data>
</odoo>