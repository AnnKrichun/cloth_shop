<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_cloth_collection_list" model="ir.ui.view">
            <field name="name">cloth.collection.list</field>
            <field name="model">cloth.collection</field>
            <field name="arch" type="xml">
                <list string="Collections">
                    <field name="year"/>
                    <field name="season"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_cloth_collection_form" model="ir.ui.view">
            <field name="name">cloth.collection.form</field>
            <field name="model">cloth.collection</field>
            <field name="arch" type="xml">
                <form string="Collection">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" placeholder="e.g. Denim, Urban"/>
                                <field name="year"/>
                            </group>
                            <group>
                                <field name="season"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_cloth_collection" model="ir.actions.act_window">
            <field name="name">Collections Dictionary</field>
            <field name="res_model">cloth.collection</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
