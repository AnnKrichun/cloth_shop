<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. АНАЛІТИЧНА PIVOT ТАБЛИЦЯ -->
        <record id="view_cloth_inventory_report_pivot" model="ir.ui.view">
            <field name="name">cloth.inventory.report.pivot</field>
            <field name="model">cloth.inventory.report</field>
            <field name="arch" type="xml">
                <pivot string="Inventory Turnover Analytics" sample="1">
                    <field name="brand_id" type="row"/>
                    <field name="product_id" type="row"/>
                    <field name="size_id" type="row"/>
                    <field name="doc_name" type="row"/>

                    <field name="qty_incoming" type="measure"/>
                    <field name="qty_outgoing" type="measure"/>
                    <field name="qty_balance" type="measure"/>
                    <field name="purchase_value" type="measure"/>
                    <field name="retail_value" type="measure"/>
                    <field name="retail_price" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- 2. НОВЕ: ПРЕДСТАВЛЕННЯ СПИСКУ ДЛЯ ДЕТАЛІЗАЦІЇ (ФІКС ПОРОЖНЬОГО ВІКНА) -->
        <record id="view_cloth_inventory_report_tree" model="ir.ui.view">
            <field name="name">cloth.inventory.report.list</field>
            <field name="model">cloth.inventory.report</field>
            <field name="arch" type="xml">
                <list string="Detailed Movement Lines" create="0" edit="0" delete="0">
                    <field name="date"/>
                    <field name="brand_id"/>
                    <field name="product_id"/>
                    <field name="size_id"/>
                    <field name="doc_name" string="Document Number"/>
                    <field name="qty_incoming"/>
                    <field name="qty_outgoing"/>
                    <field name="qty_balance"/>
                    <!-- КНОПКА ДЛЯ ВХОДУ В ДОКУМЕНТ -->
                    <button name="action_open_source_document" string="Open Original Document" type="object" icon="fa-external-link" class="btn-primary"/>
                </list>
            </field>
        </record>

        <!-- 3. ГРАФІК АНАЛІЗУ ЗАЛИШКІВ -->
        <record id="view_cloth_inventory_report_graph" model="ir.ui.view">
            <field name="name">cloth.inventory.report.graph</field>
            <field name="model">cloth.inventory.report</field>
            <field name="arch" type="xml">
                <graph string="Stock Turnover Analysis" type="bar" sample="1">
                    <field name="product_id" type="row"/>
                    <field name="qty_balance" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- 4. ПАНЕЛЬ ПОШУКУ -->
        <record id="view_cloth_inventory_report_search" model="ir.ui.view">
            <field name="name">cloth.inventory.report.search</field>
            <field name="model">cloth.inventory.report</field>
            <field name="arch" type="xml">
                <search string="Inventory Report Filters">
                    <field name="product_id"/>
                    <field name="brand_id"/>
                    <field name="collection_id"/>
                    <field name="size_id"/>
                    <field name="doc_name"/>
                    <filter string="Last 30 Days" name="filter_last_month" domain="[('report_period', '=', 'last_month')]"/>
                </search>
            </field>
        </record>

        <!-- 5. ВІКОННА ДІЯ (ДОДАНО РЕЖИМ LIST ДЛЯ ПРАВИЛЬНОГО ПРОВАЛЮВАННЯ) -->
        <record id="action_cloth_inventory_report" model="ir.actions.act_window">
            <field name="name">Inventory Turnover Report</field>
            <field name="res_model">cloth.inventory.report</field>
            <field name="view_mode">pivot,graph,list</field> <!-- Додано list сюди -->
            <field name="search_view_id" ref="view_cloth_inventory_report_search"/>
            <field name="context">{
                'search_default_filter_last_month': 1
            }</field>
        </record>

    </data>
</odoo>
