<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Послідовність для "Надходження товару" -->
        <record id="seq_cloth_receipt" model="ir.sequence">
            <field name="name">Надходження товару</field>
            <field name="code">cloth.receipt</field>
            <field name="prefix">НТ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Послідовність для "Замовлення товару" -->
        <record id="seq_cloth_order" model="ir.sequence">
            <field name="name">Замовлення товару</field>
            <field name="code">cloth.order</field>
            <field name="prefix">ЗМ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
