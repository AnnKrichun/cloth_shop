<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================================= -->
        <!-- USER ROLES & GROUPS CONFIGURATION LAYERS                                  -->
        <!-- ========================================================================= -->

        <!-- 1. Sales Manager Role: Base access level inheriting standard employee rights -->
        <record id="group_cloth_shop_user" model="res.groups">
            <field name="name">Clothing Shop: Sales Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 2. Product Manager Role: Inherits all Sales Manager parameters -->
        <record id="group_cloth_shop_product_manager" model="res.groups">
            <field name="name">Clothing Shop: Product Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_cloth_shop_user'))]"/>
        </record>

        <!-- 3. Application Administrator Role: Inherits all Product Manager parameters -->
        <record id="group_cloth_shop_admin" model="res.groups">
            <field name="name">Clothing Shop: Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_cloth_shop_product_manager'))]"/>
        </record>

        <!-- ODOO SUPERUSER INTEGRATION: Binds custom admin security layer to core system administrators group -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('cloth_shop.group_cloth_shop_admin'))]"/>
        </record>

        <!-- ========================================================================= -->
        <!-- RECORD-LEVEL SECURITY RULES (IR.RULE)                                     -->
        <!-- ========================================================================= -->

        <!-- Multi-Company Data Isolation Rule for Customer Orders -->
        <record id="rule_cloth_order_multi_company" model="ir.rule">
            <field name="name">Cloth Order Multi-Company Rule</field>
            <field name="model_id" ref="cloth_shop.model_cloth_order"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('line_ids.product_id.company_id', '=', False), ('line_ids.product_id.company_id', 'in', company_ids)]</field>
        </record>

        <!-- Price Protection Rule: Restricts write operations on markup parameters matrices -->
        <record id="rule_cloth_markup_admin_only_write" model="ir.rule">
            <field name="name">Cloth Markup Coefficients: Admin Write Only</field>
            <field name="model_id" ref="cloth_shop.model_cloth_markup_coefficient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cloth_shop.group_cloth_shop_product_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Full Partners Database Directory Access Layout Strategy for Sales Managers -->
        <record id="group_cloth_shop_user_partner_access" model="ir.rule">
            <field name="name">Clothing Shop Managers: Full Partners Access</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('cloth_shop.group_cloth_shop_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
